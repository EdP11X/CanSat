###############################
# Node & build
/frontend/node_modules/
/frontend/public/build
/frontend/public/hot
/frontend/dist/
/frontend/build/

# Composer / Laravel
/frontend/vendor/
/frontend/storage/
/frontend/storage/*.key
/frontend/storage/pail
/frontend/public/storage

# ENV del frontend
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# Cachés del frontend
/frontend/.phpunit.cache
/frontend/.phpunit.result.cache
/frontend/auth.json

# Homestead
/frontend/Homestead.json
/frontend/Homestead.yaml


