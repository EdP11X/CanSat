###############################
#         PYTHON API
###############################
# Virtual env
/api/venv/

# Python cache
/api/__pycache__/
__pycache__/

# Python env files
/api/.env
/api/.env.*

# Data folders (pesadas)
/api/data/*
/api/frames/*

# Si tienes entradas EXCEPCIONALES dentro de /api/data
# que sí quieras trackear, ponlas así:
!/api/data/wwf_ecoregions.geojson


